{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meilleurerp",
  "compatibility_date": "2026-07-02",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
    // Les pages passent par le Worker (journal des robots) ; fichiers statiques servis directement.
    "run_worker_first": ["/*", "!/_astro/*", "!/images/*", "!/favicon.ico", "!/favicon.png", "!/favicon-32.png", "!/apple-touch-icon.png", "!/logo.png"]
  },
  // Statistiques et administration : Durable Object à stockage SQLite (offre gratuite comprise).
  "durable_objects": {
    "bindings": [{ "name": "STATS", "class_name": "StatsStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StatsStore"] }]
}
