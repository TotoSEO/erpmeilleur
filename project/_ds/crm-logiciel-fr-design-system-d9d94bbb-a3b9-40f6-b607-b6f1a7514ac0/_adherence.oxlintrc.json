{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/editorial/**",
              "components/layout/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Hanken Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Hanken Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|variant|mono|dot|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, variant, mono, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|blue|teal|orange|positive|negative)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'blue' | 'teal' | 'orange' | 'positive' | 'negative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|outline|solid|gradient|pop)$/]",
        "message": "<Badge> variant must be one of 'soft' | 'outline' | 'solid' | 'gradient' | 'pop'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|as|iconLeft|iconRight|disabled|fullWidth|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, as, iconLeft, iconRight, disabled, fullWidth, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|teal|minium|minium-outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'teal' | 'minium' | 'minium-outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|label|icon|children|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: tone, label, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:astuce|retenir|attention)$/]",
        "message": "<Callout> tone must be one of 'astuce' | 'retenir' | 'attention'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chart'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|caption|values|max|highlight|height|style|key|ref|className|style|children)$/]",
        "message": "<Chart> doesn't accept that prop. Declared props: title, caption, values, max, highlight, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColumnRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:layout|gap|align|collapseAt|children|key|ref|className|style|children)$/]",
        "message": "<ColumnRow> doesn't accept that prop. Declared props: layout, gap, align, collapseAt, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColumnRow'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:image-text|text-image|two|aside-body|body-aside|three)$/]",
        "message": "<ColumnRow> layout must be one of 'image-text' | 'text-image' | 'two' | 'aside-body' | 'body-aside' | 'three'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColumnRow'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|center|stretch)$/]",
        "message": "<ColumnRow> align must be one of 'start' | 'center' | 'stretch'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|num|align|width|sticky|key|ref|className|style|children)$/]",
        "message": "<DataColumn> doesn't accept that prop. Declared props: key, label, num, align, width, sticky."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<DataColumn> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaderItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|max|key|ref|className|style|children)$/]",
        "message": "<FaderItem> doesn't accept that prop. Declared props: label, value, max."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureColumnAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|onClick|key|ref|className|style|children)$/]",
        "message": "<FeatureColumnAction> doesn't accept that prop. Declared props: label, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|padding|radius|strong|children|key|ref|className|style|children)$/]",
        "message": "<GlassPanel> doesn't accept that prop. Declared props: as, padding, radius, strong, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg|xl)$/]",
        "message": "<GlassPanel> padding must be one of 'none' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:md|lg|xl|2xl)$/]",
        "message": "<GlassPanel> radius must be one of 'md' | 'lg' | 'xl' | '2xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|prefix|suffix|mono|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, prefix, suffix, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductSpec'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<ProductSpec> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProsCons'] > JSXAttribute > JSXIdentifier[name!=/^(?:pros|cons|prosTitle|consTitle|gap|collapseAt|style|key|ref|className|style|children)$/]",
        "message": "<ProsCons> doesn't accept that prop. Declared props: pros, cons, prosTitle, consTitle, gap, collapseAt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|author|role|initials|style|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: children, author, role, initials, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatDisc'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|label|gradient|key|ref|className|style|children)$/]",
        "message": "<StatDisc> doesn't accept that prop. Declared props: value, unit, label, gradient."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
