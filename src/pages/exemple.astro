---
import { getEntry, render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';

import Callout from '../components/Callout.astro';
import PullQuote from '../components/PullQuote.astro';
import ProsCons from '../components/ProsCons.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import GlassPanel from '../components/GlassPanel.astro';
import ColumnRow from '../components/ColumnRow.astro';
import Visual from '../components/Visual.astro';
import FeatureColumns from '../components/FeatureColumns.astro';
import DataTable from '../components/DataTable.astro';
import StatDiscs from '../components/StatDiscs.astro';
import Faders from '../components/Faders.astro';
import Chart from '../components/Chart.astro';
import ProductCard from '../components/ProductCard.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import Input from '../components/Input.astro';

const entry = await getEntry('articles', 'exemple');
const { Content, headings } = await render(entry!);
---
<ArticleLayout frontmatter={entry!.data} headings={headings}>
  <Content />

  <Fragment slot="after">
    <section class="showcase" id="bibliotheque">
      <div class="showcase__intro">
        <Badge tone="orange" variant="pop" mono>Bibliothèque de composants</Badge>
        <h2>Les blocs réutilisables</h2>
        <p>Voici chaque composant disponible pour la rédaction, avec son rendu et la façon de l'appeler dans un article (MDX). Copiez la balise, remplissez le contenu : le style suit automatiquement la charte.</p>
      </div>

      {/* ------------------------------ Éditorial ------------------------------ */}
      <div class="lib">
        <div class="lib__head"><span class="lib__name">Callout</span><span class="lib__tag">Éditorial</span><p class="lib__desc">Encadré d'info : 3 tons (astuce / retenir / attention).</p></div>
        <div class="lib__demo">
          <Callout tone="astuce">Importez d'abord <b>50 articles test</b> avant la migration complète.</Callout>
          <Callout tone="retenir" label="À retenir">Le prix affiché ne prédit pas la qualité du support.</Callout>
          <Callout tone="attention">Vérifiez la clause de réversibilité <b>avant</b> de signer.</Callout>
          <div class="lib__code">{`<Callout tone="astuce">Votre texte…</Callout>
<Callout tone="retenir" label="À retenir">…</Callout>
<Callout tone="attention">…</Callout>`}</div>
        </div>
      </div>

      <div class="lib">
        <div class="lib__head"><span class="lib__name">PullQuote</span><span class="lib__tag">Éditorial</span><p class="lib__desc">Citation mise en avant avec signature.</p></div>
        <div class="lib__demo">
          <PullQuote author="Julien Lefevre" role="Auteur · testé sur compte réel" initials="JL">Un ERP se choisit sur la friction qu'il vous enlève, pas sur sa liste de modules.</PullQuote>
          <div class="lib__code">{`<PullQuote author="Julien Lefevre" role="Auteur" initials="JL">
  Votre citation…
</PullQuote>`}</div>
        </div>
      </div>

      <div class="lib">
        <div class="lib__head"><span class="lib__name">ProsCons</span><span class="lib__tag">Éditorial</span><p class="lib__desc">Double colonne Avantages / Inconvénients, même hauteur.</p></div>
        <div class="lib__demo">
          <ProsCons pros={['Mise en route rapide', 'Support FR réactif']} cons={['États peu personnalisables', 'Appli mobile perfectible']} />
          <div class="lib__code">{`<ProsCons
  pros={['Avantage 1', 'Avantage 2']}
  cons={['Limite 1', 'Limite 2']}
/>`}</div>
        </div>
      </div>

      <div class="lib">
        <div class="lib__head"><span class="lib__name">KeyTakeaways</span><span class="lib__tag">Éditorial</span><p class="lib__desc">Encart « Les points à retenir ». Géré via le frontmatter de l'article (champ <code>takeaways</code>), ou en direct.</p></div>
        <div class="lib__demo">
          <KeyTakeaways items={['Premier point <strong>clé</strong>.', 'Deuxième point important.', 'Troisième repère utile.']} />
          <div class="lib__code">{`# Dans le frontmatter de l'article :
takeaways:
  - 'Premier point clé.'
  - 'Deuxième point.'`}</div>
        </div>
      </div>

      {/* ------------------------------ Mise en page ------------------------------ */}
      <div class="lib">
        <div class="lib__head"><span class="lib__name">ColumnRow + Visual</span><span class="lib__tag">Mise en page</span><p class="lib__desc">Colonnage pour rythmer l'article : image+texte, 2 colonnes, aparté+corps, grille 3.</p></div>
        <div class="lib__demo">
          <ColumnRow layout="image-text" align="center" gap={28}>
            <Visual label="Capture annotée" height={150} />
            <div><h3 style="font-family:var(--font-grotesk);margin:0 0 8px">Image + texte</h3><p style="margin:0;color:var(--ink-80)">Une colonne visuelle, une colonne de texte. Repasse en pleine largeur sur mobile.</p></div>
          </ColumnRow>
          <div class="lib__code">{`<ColumnRow layout="image-text" align="center">
  <Visual label="Légende" />
  <div>Votre texte…</div>
</ColumnRow>
// layout = image-text | text-image | two | aside-body | body-aside | three`}</div>
        </div>
      </div>

      <div class="lib">
        <div class="lib__head"><span class="lib__name">FeatureColumns</span><span class="lib__tag">Mise en page</span><p class="lib__desc">Colonnes alignées de même hauteur : picto, titre H3, texte, bouton en bas.</p></div>
        <div class="lib__demo">
          <FeatureColumns columns={3} items={[
            { eyebrow: 'Étape 1', title: 'On teste', text: 'Comptes réels, données réelles, mesures datées.', action: { label: 'En savoir plus', href: '#' } },
            { eyebrow: 'Étape 2', title: 'On mesure', text: 'Prix à 12 mois, mise en route, support chronométré.', action: { label: 'La méthode', href: '#' } },
            { eyebrow: 'Étape 3', title: 'On signe', text: 'Un verdict daté, signé, sans contenu d\'éditeur.', action: { label: 'Nos verdicts', href: '#' } },
          ]} />
          <div class="lib__code">{`<FeatureColumns columns={3} items={[
  { eyebrow:'Étape 1', title:'Titre', text:'…', action:{ label:'Lien', href:'#' } },
]} />`}</div>
        </div>
      </div>

      <div class="lib">
        <div class="lib__head"><span class="lib__name">GlassPanel</span><span class="lib__tag">Mise en page</span><p class="lib__desc">Panneau de base (coins nets, bord encre, ombre dure). padding : sm…xl.</p></div>
        <div class="lib__demo">
          <GlassPanel padding="md"><div class="kicker" style="margin-bottom:6px">En bref</div><p style="margin:0;color:var(--ink-80)">Un encadré neutre pour isoler une info.</p></GlassPanel>
          <div class="lib__code">{`<GlassPanel padding="md">Votre contenu…</GlassPanel>`}</div>
        </div>
      </div>

      {/* ------------------------------ Données ------------------------------ */}
      <div class="lib">
        <div class="lib__head"><span class="lib__name">DataTable</span><span class="lib__tag">Données</span><p class="lib__desc">Tableau comparatif : en-tête dégradé, ligne « best », colonnes mono.</p></div>
        <div class="lib__demo">
          <DataTable
            columns={[{ key: 'o', label: 'ERP', sticky: true }, { key: 'p', label: 'Prix', num: true }, { key: 's', label: 'Support' }, { key: 'n', label: 'Note', num: true }]}
            rows={[
              { o: 'Outil A', p: '4 680 €', s: { value: 'Excellent', tone: 'positive' }, n: '8,7', _best: true },
              { o: 'Outil C', p: '3 240 €', s: { value: 'Moyen', tone: 'muted' }, n: '7,4' },
            ]}
          />
          <div class="lib__code">{`<DataTable
  columns={[{ key:'o', label:'ERP', sticky:true }, { key:'p', label:'Prix', num:true }]}
  rows={[{ o:'Outil A', p:'4 680 €', _best:true }]}
/>  // cellule colorée : { value:'…', tone:'positive|negative|muted|strong' }`}</div>
        </div>
      </div>

      <div class="lib">
        <div class="lib__head"><span class="lib__name">StatDiscs</span><span class="lib__tag">Données</span><p class="lib__desc">Disques de chiffres clés qui flottent en couches.</p></div>
        <div class="lib__demo">
          <StatDiscs items={[{ value: '8', unit: '/10', label: 'Note finale' }, { value: '6', unit: ' sem.', label: 'Mise en route' }, { value: '2400', label: 'Articles' }, { value: '42', label: 'ERP testés' }]} />
          <div class="lib__code">{`<StatDiscs items={[
  { value:'8', unit:'/10', label:'Note' },
  { value:'6', unit:' sem.', label:'Mise en route' },
]} />`}</div>
        </div>
      </div>

      <div class="lib">
        <div class="lib__head"><span class="lib__name">Faders</span><span class="lib__tag">Données</span><p class="lib__desc">Notation type console : curseur sur rail gradué.</p></div>
        <div class="lib__demo">
          <Faders items={[{ label: 'Prise en main', value: 8.7 }, { label: 'Support FR', value: 7.4 }, { label: 'Rapport prix', value: 6.2 }]} />
          <div class="lib__code">{`<Faders items={[
  { label:'Prise en main', value:8.7 },
  { label:'Support FR', value:7.4, max:10 },
]} />`}</div>
        </div>
      </div>

      <div class="lib">
        <div class="lib__head"><span class="lib__name">Chart</span><span class="lib__tag">Données</span><p class="lib__desc">Graphique clair : aire + ligne dégradées, point d'inflexion.</p></div>
        <div class="lib__demo">
          <Chart title="Mise en route" caption="30 jours" values={[4, 9, 18, 30, 48, 62, 71, 78, 83]} highlight={3} />
          <div class="lib__code">{`<Chart title="Mise en route" caption="30 jours"
  values={[4, 9, 18, 30, 48, 62]} highlight={3} />`}</div>
        </div>
      </div>

      <div class="lib">
        <div class="lib__head"><span class="lib__name">ProductCard</span><span class="lib__tag">Données</span><p class="lib__desc">Fiche outil avec pastille de note qui déborde du coin.</p></div>
        <div class="lib__demo">
          <div style="max-width:360px;margin-top:18px">
            <ProductCard name="Outil A" category="ERP industriel" score={8.7} verdict="positive" specs={[{ label: 'Prix 12 mois', value: '4 680 €' }, { label: 'Mise en route', value: '6 sem.' }, { label: 'Support', value: 'FR' }]} />
          </div>
          <div class="lib__code">{`<ProductCard name="Outil A" category="ERP" score={8.7}
  verdict="positive" specs={[{ label:'Prix', value:'4 680 €' }]} />`}</div>
        </div>
      </div>

      {/* ------------------------------ Base / UI ------------------------------ */}
      <div class="lib">
        <div class="lib__head"><span class="lib__name">Button</span><span class="lib__tag">Base</span><p class="lib__desc">Bouton anguleux. variant : primary / secondary / ghost / teal / minium.</p></div>
        <div class="lib__demo">
          <div class="lib__row">
            <Button variant="primary">Primaire</Button>
            <Button variant="secondary">Secondaire</Button>
            <Button variant="teal">Teal</Button>
            <Button variant="minium">Jaune</Button>
            <Button variant="ghost">Ghost</Button>
          </div>
          <div class="lib__code">{`<Button variant="primary" href="/lien">Mon bouton</Button>`}</div>
        </div>
      </div>

      <div class="lib">
        <div class="lib__head"><span class="lib__name">Badge</span><span class="lib__tag">Base</span><p class="lib__desc">Sticker. tone × variant (soft / outline / solid / gradient / pop).</p></div>
        <div class="lib__demo">
          <div class="lib__row">
            <Badge tone="blue" variant="gradient">Guide</Badge>
            <Badge tone="positive" variant="soft" dot>Recommandé</Badge>
            <Badge tone="negative" variant="outline">À éviter</Badge>
            <Badge tone="orange" variant="pop">Nouveau</Badge>
            <Badge tone="neutral" variant="soft" mono>14 min</Badge>
          </div>
          <div class="lib__code">{`<Badge tone="blue" variant="gradient">Guide</Badge>
<Badge tone="positive" variant="soft" dot>Recommandé</Badge>`}</div>
        </div>
      </div>

      <div class="lib">
        <div class="lib__head"><span class="lib__name">Input</span><span class="lib__tag">Base</span><p class="lib__desc">Champ de saisie ; valeur numérique en mono via <code>mono</code>.</p></div>
        <div class="lib__demo">
          <div style="display:grid;gap:16px;max-width:420px">
            <Input label="Votre e-mail" type="email" placeholder="vous@entreprise.fr" />
            <Input label="Budget mensuel" mono prefix="€" suffix="/ mois" placeholder="0" hint="Hors options et reprise de données." />
          </div>
          <div class="lib__code">{`<Input label="Votre e-mail" type="email" placeholder="…" />
<Input label="Budget" mono prefix="€" suffix="/ mois" />`}</div>
        </div>
      </div>
    </section>
  </Fragment>
</ArticleLayout>
