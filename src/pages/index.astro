---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import StatDiscs from '../components/StatDiscs.astro';
import FeatureColumns from '../components/FeatureColumns.astro';

const SITE = 'https://meilleur-erp.fr';
const homeLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: 'meilleur-erp.fr',
      url: SITE,
      description: "Le média indépendant des logiciels ERP : définitions, fonctionnement, modules, déploiement et coûts, expliqués simplement.",
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: 'meilleur-erp.fr',
      inLanguage: 'fr-FR',
      publisher: { '@id': `${SITE}/#organization` },
    },
  ],
};

// Points d'entrée du cocon : les grands sujets, vers les articles hubs.
const parcours = [
  { eyebrow: 'Les bases', title: "Qu'est-ce qu'un ERP ?", text: 'Définition simple, fonctionnement et exemple concret. Le point de départ.', action: { label: 'Lire le guide', href: '/qu-est-ce-qu-un-erp/' } },
  { eyebrow: 'Fonctions', title: 'Les modules', text: 'Finance, ventes, stocks, production, RH : le panorama des briques et lesquelles activer.', action: { label: 'Voir les modules', href: '/modules-erp/' } },
  { eyebrow: 'Budget', title: 'Combien ça coûte', text: 'Licence, intégration, maintenance : les postes de coût et les fourchettes réelles.', action: { label: 'Comprendre le prix', href: '/prix-erp/' } },
  { eyebrow: 'Déploiement', title: 'Cloud, SaaS ou sur site', text: 'Les modes d’hébergement comparés, avec leurs coûts et leur logique de contrôle.', action: { label: 'Choisir le mode', href: '/erp-cloud-saas-on-premise/' } },
  { eyebrow: 'Méthode', title: 'Comment choisir', text: 'Une grille de critères et une démarche pour ne pas se tromper de solution.', action: { label: 'La méthode', href: '/comment-choisir-un-erp/' } },
  { eyebrow: 'Projet', title: 'Mettre en place un ERP', text: 'Les étapes d’un projet, de la préparation au go-live, et les pièges à éviter.', action: { label: 'Réussir son projet', href: '/mise-en-place-erp/' } },
];
---
<BaseLayout title="meilleur-erp.fr : comprendre les logiciels ERP, simplement">
  <script type="application/ld+json" set:html={JSON.stringify(homeLd)} is:inline />

  <div class="container" style="padding-top:56px;padding-bottom:24px">
    <div class="hero__grid">
      <div>
        <div class="hero__top">
          <Badge tone="blue" variant="gradient">Média indépendant</Badge>
          <Badge tone="neutral" variant="soft" mono>38 guides ERP</Badge>
        </div>
        <h1 class="hero" style="padding:0;font-family:var(--font-grotesk);font-weight:800;font-size:clamp(38px,7vw,68px);line-height:0.96;letter-spacing:-0.03em;color:var(--ink);margin:0">
          Les ERP, <span class="text-gradient">expliqués simplement</span>.
        </h1>
        <p class="hero__excerpt" style="margin-top:20px">
          Définitions claires, exemples concrets, chiffres réels. Un média indépendant qui explique les logiciels de gestion sans jargon et sans discours d'éditeur.
        </p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px">
          <Button variant="primary" size="lg" href="/qu-est-ce-qu-un-erp/">Commencer par la définition</Button>
          <Button variant="secondary" size="lg" href="/glossaire-erp/">Le glossaire</Button>
        </div>
      </div>
      <div style="display:grid;place-items:center">
        <StatDiscs items={[{ value: '38', label: 'Guides ERP' }, { value: '0', label: "Discours d'éditeur" }, { value: '100', unit: '%', label: 'Indépendant' }]} />
      </div>
    </div>
  </div>

  <section class="container" style="padding-top:24px;padding-bottom:16px">
    <div style="max-width:var(--measure-text)">
      <div class="kicker" style="margin-bottom:8px">Par où commencer</div>
      <h2 style="font-family:var(--font-grotesk);font-weight:800;font-size:clamp(24px,4vw,34px);letter-spacing:-0.02em;color:var(--ink);margin:0 0 10px">Le guide complet de l'ERP</h2>
      <p style="font-family:var(--font-body);font-size:var(--text-lg);line-height:var(--leading-relaxed);color:var(--ink-80);margin:0 0 26px">
        De la définition au choix de la solution : les grands sujets à connaître, chacun traité à fond et relié aux autres.
      </p>
    </div>
    <FeatureColumns columns={3} items={parcours} />
  </section>

  <section class="container" style="padding-top:8px;padding-bottom:48px">
    <div style="border:2px solid var(--ink);box-shadow:var(--shadow-raise);padding:24px;display:flex;gap:18px;align-items:center;flex-wrap:wrap">
      <span class="hero__avatar" style="width:56px;height:56px;font-size:20px;flex:none">GW</span>
      <div style="flex:1;min-width:240px">
        <div style="font-family:var(--font-grotesk);font-weight:700;color:var(--ink)">Écrit par Guillaume Wagner</div>
        <p style="margin:4px 0 0;font-size:14.5px;line-height:1.55;color:var(--ink-80)">Des explications concrètes, des chiffres, et l'honnêteté sur les limites autant que sur les bénéfices.</p>
      </div>
      <Button variant="ghost" href="/auteur/">L'auteur</Button>
    </div>
  </section>
</BaseLayout>
