---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';

/**
 * Route dynamique des articles du cocon : chaque entrée de la collection
 * « articles » est servie à son slug (= nom de fichier). L'article de
 * démonstration `exemple` garde sa page dédiée (/exemple/) et est exclu ici.
 * Les composants utilisés sont importés directement dans chaque fichier MDX.
 */
export async function getStaticPaths() {
  const articles = await getCollection('articles', (e) => e.id !== 'exemple');
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<ArticleLayout frontmatter={entry.data} headings={headings}>
  <Content />
</ArticleLayout>
