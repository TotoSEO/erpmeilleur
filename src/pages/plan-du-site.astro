---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { PILIER, SECTIONS } from '../data/cocon';

const SITE = 'https://meilleur-erp.fr';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Plan du site', item: `${SITE}/plan-du-site/` },
  ],
};
---
<BaseLayout
  title="Plan du site · meilleur-erp.fr"
  description="Plan du site meilleur-erp.fr : tous les guides ERP organisés par thème, des notions de base aux sujets les plus précis."
>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} is:inline />
  <div class="article-layout" style="padding-top:32px">
    <div class="article-content" style="max-width:960px">
      <Breadcrumb items={[{ name: 'Accueil', href: '/' }, { name: 'Plan du site' }]} />
      <h1 style="font-family:var(--font-grotesk);font-weight:800;font-size:clamp(28px,5vw,42px);letter-spacing:-0.02em;color:var(--ink);margin:0 0 6px">Plan du site</h1>
      <p style="font-family:var(--font-body);font-size:var(--text-lg);line-height:var(--leading-relaxed);color:var(--ink-80);margin:0 0 28px">
        Tous les guides ERP, organisés par thème. On part des notions de base pour aller vers des sujets de plus en plus précis.
      </p>

      <p style="margin:0 0 30px">
        <a href={`/${PILIER.slug}/`} style="font-family:var(--font-grotesk);font-weight:700;font-size:20px;color:var(--blue-ink)">★ {PILIER.label}</a>
        <span style="display:block;font-size:14px;color:var(--ink-55);margin-top:2px">Le guide de référence : la meilleure porte d'entrée pour commencer.</span>
      </p>

      <div class="sitemap-grid">
        {SECTIONS.map((s) => (
          <section class="sitemap-block">
            <h2>{s.label}</h2>
            <ul>
              {s.key !== 'comprendre' && (
                <li><a href={`/${s.hub.slug}/`} class="sitemap-hub">{s.hub.label}</a></li>
              )}
              {s.items.map((l) => (<li><a href={`/${l.slug}/`}>{l.label}</a></li>))}
            </ul>
          </section>
        ))}
        <section class="sitemap-block">
          <h2>Le média</h2>
          <ul>
            <li><a href="/">Accueil</a></li>
            <li><a href="/auteur/">Guillaume Wagner, auteur</a></li>
            <li><a href="/mentions-legales/">Mentions légales</a></li>
          </ul>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .sitemap-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 26px 34px; }
  .sitemap-block h2 { font-family: var(--font-grotesk); font-weight: 800; font-size: 18px; color: var(--ink); margin: 0 0 12px; padding-left: 14px; position: relative; }
  .sitemap-block h2::before { content: ""; position: absolute; left: 0; top: 0.15em; bottom: 0.15em; width: 5px; background: var(--grad-brand); }
  .sitemap-block ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .sitemap-block a { font-family: var(--font-ui); font-size: 14.5px; color: var(--ink-80); text-decoration: none; }
  .sitemap-block a:hover { color: var(--blue-ink); text-decoration: underline; text-underline-offset: 2px; }
  .sitemap-hub { font-weight: 700; color: var(--ink) !important; }
</style>
