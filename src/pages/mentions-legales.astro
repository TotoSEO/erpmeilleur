---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Mentions légales — page statique simple, hors collection « articles ».
 * Éditeur : entrepreneur individuel (LCEN art. 6-III-1 : nom, domicile, téléphone,
 * numéro d'immatriculation). Hébergeur : Cloudflare France SAS.
 * Section « Classements et liens d'intérêts » : information exigée pour les
 * contenus qui classent des offres (art. L111-7 et D111-7 du Code de la consommation).
 */
const updated = '12 octobre 2026';

// Identité de l'éditeur (LCEN). Les champs « À COMPLÉTER » doivent être remplis avant mise en ligne.
const EDITEUR = {
  nom: 'Thomas Owaller (EI)',
  siren: '[À COMPLÉTER]',
  adresse: '4 rue de Bruges, [CODE POSTAL ET VILLE À COMPLÉTER], France',
  telephone: '[À COMPLÉTER]',
};
const SITE = 'https://meilleur-erp.fr';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Mentions légales',
  url: `${SITE}/mentions-legales/`,
  inLanguage: 'fr-FR',
  isPartOf: { '@type': 'WebSite', name: 'meilleur-erp.fr', url: SITE },
  publisher: { '@type': 'Organization', name: 'meilleur-erp.fr', url: SITE },
};
---
<BaseLayout
  title="Mentions légales · meilleur-erp.fr"
  description="Mentions légales du site meilleur-erp.fr : éditeur, responsable de publication, hébergeur et conditions d'utilisation."
>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} is:inline />
  <div class="article-layout" style="padding-top:48px">
    <div class="article-content">
      <h1 style="font-family:var(--font-grotesk);font-weight:800;font-size:clamp(30px,5vw,44px);letter-spacing:-0.02em;color:var(--ink);margin:0 0 10px">
        Mentions légales
      </h1>
      <p style="font-family:var(--font-mono);font-size:12px;letter-spacing:0.06em;color:var(--ink-55);margin:0 0 28px">
        Dernière mise à jour : <span class="num">{updated}</span>
      </p>

      <h2>Éditeur du site</h2>
      <p>
        Le site <strong>meilleur-erp.fr</strong> est édité par
        <strong>{EDITEUR.nom}</strong>, entrepreneur individuel (micro-entreprise).
      </p>
      <ul>
        <li>SIREN : <span class="num">{EDITEUR.siren}</span></li>
        <li>Adresse : {EDITEUR.adresse}</li>
        <li>Téléphone : <span class="num">{EDITEUR.telephone}</span></li>
        <li>E-mail : <a href="mailto:contact@meilleur-erp.fr">contact@meilleur-erp.fr</a></li>
        <li>Directeur de la publication : <strong>{EDITEUR.nom}</strong></li>
      </ul>

      <h2>Hébergement</h2>
      <p>
        Le site est hébergé sur l'infrastructure de <strong>Cloudflare</strong>
        (Europe), exploitée en France par&nbsp;:
      </p>
      <ul>
        <li><strong>Cloudflare France SAS</strong></li>
        <li>6 Place de la Madeleine, 75008 Paris, France</li>
        <li>RCS Paris <span class="num">883 044 646</span></li>
        <li>Site web : cloudflare.com</li>
      </ul>

      <h2>Classements et liens d'intérêts</h2>
      <p>
        Les classements publiés sur meilleur-erp.fr reposent sur des critères
        éditoriaux décrits dans chaque article (couverture fonctionnelle,
        adéquation à la taille et au secteur, modes de déploiement, conformité
        réglementaire, écosystème d'accompagnement). L'ordre retenu reflète une
        appréciation éditoriale et peut évoluer à chaque mise à jour.
      </p>
      <p>
        L'éditeur du site entretient des liens professionnels avec l'un des
        éditeurs de logiciels présentés dans ces classements. Cette information
        figure en tête de chaque classement. Le site n'affiche aucune publicité
        et ne contient aucun lien affilié.
      </p>
      <p>
        Les éditeurs de logiciels cités peuvent demander la correction d'une
        information les concernant ou le retrait d'un visuel de leur produit en
        écrivant à contact@meilleur-erp.fr.
      </p>
      <h2>Propriété intellectuelle</h2>
      <p>
        L'ensemble des contenus présents sur meilleur-erp.fr (textes, visuels,
        éléments graphiques, mise en page) est protégé par le droit d'auteur.
        Toute reproduction ou réutilisation, totale ou partielle, sans
        autorisation préalable de l'éditeur est interdite.
      </p>
      <p>
        Les noms, logos et captures d'écran des logiciels cités restent la
        propriété de leurs éditeurs respectifs. Ils sont reproduits à des fins
        d'information et d'identification, avec mention de leur origine.
      </p>

      <h2>Données personnelles</h2>
      <p>
        Le site collecte le minimum de données nécessaires à son fonctionnement.
        Conformément au Règlement général sur la protection des données (RGPD),
        vous disposez d'un droit d'accès, de rectification et de suppression des
        données vous concernant, en écrivant à l'adresse de contact ci-dessus.
      </p>

      <h2>Responsabilité</h2>
      <p>
        Les contenus de meilleur-erp.fr sont fournis à titre informatif. L'éditeur
        s'efforce d'en assurer l'exactitude et la mise à jour, sans pouvoir
        garantir qu'ils soient exempts d'erreurs ou d'omissions.
      </p>
    </div>
  </div>
</BaseLayout>
