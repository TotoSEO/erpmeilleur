---
import BaseLayout from './BaseLayout.astro';
import ArticleHero from '../components/ArticleHero.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { parentOf } from '../data/cocon';

/**
 * ArticleLayout — gabarit d'un article de blog meilleur-erp.fr :
 * héros 2 colonnes -> encart « Les points à retenir » -> (mobile : sommaire
 * dépliable) -> contenu, avec un sommaire sticky scroll-spy en colonne de gauche
 * sur desktop.
 */
interface Heading { depth: number; slug: string; text: string; }
interface Props {
  frontmatter: {
    title: string;
    seoTitle?: string;
    excerpt: string;
    description?: string;
    badges?: any[];
    author?: { name: string; role?: string; initials?: string };
    readingTime?: string;
    publishedDate?: string;
    updatedDate?: string;
    heroImage?: string;
    heroAlt?: string;
    heroLabel?: string;
    takeaways?: string[];
    faq?: { q: string; a: string }[];
    ranking?: { name: string; editor?: string; anchor?: string }[];
  };
  headings: Heading[];
}
const { frontmatter: fm, headings } = Astro.props;

const SITE = 'https://meilleur-erp.fr';
const cleanTitle = fm.title.replace(/<[^>]+>/g, '');
const pageTitle = fm.seoTitle || `${cleanTitle} · meilleur-erp.fr`;
const canonical = Astro.url.href;
// Contenus signés par le site lui-même (pas d'auteur individuel).
const publisher = {
  '@type': 'Organization',
  name: 'meilleur-erp.fr',
  url: SITE,
};
const author = publisher;

// Fil d'Ariane hiérarchique : Accueil › hub de la branche › page courante.
// N1 -> pilier ; N2 -> hub (ex. Modules) ; pilier -> racine.
const slug = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const parent = parentOf(slug);
const crumbs: { name: string; url: string }[] = [{ name: 'Accueil', url: `${SITE}/` }];
if (parent) crumbs.push({ name: parent.label, url: `${SITE}/${parent.slug}/` });
crumbs.push({ name: cleanTitle, url: canonical });

// Données structurées : Article + (FAQPage) + BreadcrumbList, regroupées en @graph.
const graph: any[] = [
  {
    '@type': 'Article',
    headline: cleanTitle,
    description: fm.description || fm.excerpt,
    inLanguage: 'fr-FR',
    mainEntityOfPage: canonical,
    author,
    datePublished: fm.publishedDate,
    dateModified: fm.updatedDate || fm.publishedDate,
    publisher,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name, item: c.url,
    })),
  },
];
if (fm.faq && fm.faq.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: fm.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
// Pages classement : la liste ordonnée des solutions (ItemList de SoftwareApplication).
if (fm.ranking && fm.ranking.length > 0) {
  graph.push({
    '@type': 'ItemList',
    name: cleanTitle,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: fm.ranking.length,
    itemListElement: fm.ranking.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: r.anchor ? `${canonical}#${r.anchor}` : canonical,
      item: {
        '@type': 'SoftwareApplication',
        name: r.name,
        applicationCategory: 'BusinessApplication',
        applicationSubCategory: 'ERP',
        ...(r.editor ? { publisher: { '@type': 'Organization', name: r.editor } } : {}),
      },
    })),
  });
}
const ld = { '@context': 'https://schema.org', '@graph': graph };
---
<BaseLayout title={pageTitle} description={fm.description || fm.excerpt} current="guides" ogImage={fm.heroImage} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} is:inline />
  <div class="article-layout">
    <Breadcrumb items={crumbs.map((c, i) => ({ name: c.name, href: i < crumbs.length - 1 ? c.url.replace(SITE, '') : undefined }))} />
    <ArticleHero
      title={fm.title}
      excerpt={fm.excerpt}
      badges={fm.badges}
      author={fm.author}
      readingTime={fm.readingTime}
      publishedDate={fm.publishedDate}
      updatedDate={fm.updatedDate}
      heroImage={fm.heroImage}
      heroAlt={fm.heroAlt}
      heroLabel={fm.heroLabel}
    />

    <div class="article-body">
      <TableOfContents headings={headings} variant="desktop" />

      <div class="article-content">
        {fm.ranking && fm.ranking.length > 0 && (
          <aside class="rank-disclosure" aria-label="Transparence">
            <strong>Transparence.</strong> Classement établi selon les critères décrits dans cet
            article. L'éditeur du site entretient des liens professionnels avec l'un des éditeurs
            de logiciels présentés. <a href="/a-propos/#transparence">Notre méthode</a>
          </aside>
        )}
        {fm.takeaways && fm.takeaways.length > 0 && <KeyTakeaways items={fm.takeaways} />}
        <TableOfContents headings={headings} variant="mobile" />
        <slot />
      </div>
    </div>

    <slot name="after" />
  </div>
</BaseLayout>

<script>
  // Scroll-spy : surligne l'entrée du sommaire correspondant au titre visible.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc__link'));
  const map = new Map<string, HTMLAnchorElement[]>();
  for (const l of links) {
    const id = decodeURIComponent((l.getAttribute('href') || '').slice(1));
    if (!id) continue;
    if (!map.has(id)) map.set(id, []);
    map.get(id)!.push(l);
  }
  const targets = Array.from(document.querySelectorAll<HTMLElement>('.article-content h2, .article-content h3')).filter((h) => h.id && map.has(h.id));

  if (targets.length) {
    let activeId = '';
    const setActive = (id: string) => {
      if (id === activeId) return;
      activeId = id;
      links.forEach((l) => l.classList.remove('is-active'));
      (map.get(id) || []).forEach((l) => l.classList.add('is-active'));
    };
    const onScroll = () => {
      const top = 120;
      let current = targets[0].id;
      for (const t of targets) {
        if (t.getBoundingClientRect().top - top <= 0) current = t.id;
        else break;
      }
      setActive(current);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
