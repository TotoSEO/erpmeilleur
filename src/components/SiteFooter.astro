---
import Wordmark from './Wordmark.astro';
/** SiteFooter — pied de page encre avec décor de formes coupées bleu/jaune. */
const COLS = [
  { title: 'Méthode', items: [
    { label: 'Comment on teste', href: '#' },
    { label: 'Indépendance', href: '#' },
    { label: 'Sources & dates', href: '#' },
  ] },
  { title: 'Contenus', items: [
    { label: 'Guides de décision', href: '#' },
    { label: 'Fiches avis', href: '#' },
    { label: 'Comparatifs', href: '#' },
  ] },
  { title: 'Le média', items: [
    { label: 'Guillaume Wagner', href: '#' },
    { label: 'Contact', href: '#' },
    { label: 'Mentions légales', href: '/mentions-legales/' },
  ] },
];
---
<footer class="site-footer">
  <div class="site-footer__deco" aria-hidden="true"></div>
  <div class="site-footer__grid">
    <div>
      <Wordmark size={20} inverse />
      <p class="site-footer__about">Le premier blog indépendant des logiciels ERP. On mesure, on date, on signe.</p>
    </div>
    {COLS.map((c) => (
      <div>
        <h4>{c.title}</h4>
        <ul>{c.items.map((it) => (<li><a href={it.href}>{it.label}</a></li>))}</ul>
      </div>
    ))}
  </div>
  <div class="site-footer__legal">
    <div class="site-footer__legal-in">© 2026 meilleur-erp.fr · <span class="num">42</span> ERP testés · Mis à jour le <span class="num">23 juin 2026</span></div>
  </div>
</footer>
