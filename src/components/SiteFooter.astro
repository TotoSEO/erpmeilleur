---
import Wordmark from './Wordmark.astro';
/** SiteFooter — pied de page encre avec décor de formes coupées bleu/jaune. */
const COLS = [
  { title: 'Comprendre', items: [
    { label: "Qu'est-ce qu'un ERP", href: '/qu-est-ce-qu-un-erp/' },
    { label: 'À quoi ça sert', href: '/a-quoi-sert-un-erp/' },
    { label: 'Les modules', href: '/modules-erp/' },
  ] },
  { title: 'Choisir & déployer', items: [
    { label: 'Combien ça coûte', href: '/prix-erp/' },
    { label: 'Comment choisir', href: '/comment-choisir-un-erp/' },
    { label: 'Mise en place', href: '/mise-en-place-erp/' },
  ] },
  { title: 'Le média', items: [
    { label: 'Guillaume Wagner', href: '/auteur/' },
    { label: 'Contact', href: 'mailto:contact@meilleur-erp.fr' },
    { label: 'Mentions légales', href: '/mentions-legales/' },
  ] },
];
---
<footer class="site-footer">
  <div class="site-footer__deco" aria-hidden="true"></div>
  <div class="site-footer__grid">
    <div>
      <Wordmark size={26} inverse />
      <p class="site-footer__about">Le média indépendant des logiciels ERP. On explique, on source, on reste neutre.</p>
    </div>
    {COLS.map((c) => (
      <div>
        <h4>{c.title}</h4>
        <ul>{c.items.map((it) => (<li><a href={it.href}>{it.label}</a></li>))}</ul>
      </div>
    ))}
  </div>
  <div class="site-footer__legal">
    <div class="site-footer__legal-in">© 2026 meilleur-erp.fr</div>
  </div>
</footer>
