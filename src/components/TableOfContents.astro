---
/**
 * TableOfContents — sommaire d'article construit depuis les titres H2/H3.
 * variant=desktop : colonne sticky (masquée sous 1000px).
 * variant=mobile  : bouton dépliable (<details>) placé après l'encart « en bref ».
 * Le surlignage actif (scroll-spy) est géré par le script de l'ArticleLayout.
 */
interface Heading { depth: number; slug: string; text: string; }
interface Props { headings?: Heading[]; variant?: 'desktop' | 'mobile'; }
const { headings = [], variant = 'desktop' } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length > 0 && (
  variant === 'mobile' ? (
    <details class="toc-mobile">
      <summary>
        Sommaire de l'article
        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
      </summary>
      <nav class="toc" aria-label="Sommaire">
        <ul class="toc__list">
          {items.map((h) => (
            <li class={`toc__item toc__item--h${h.depth}`}>
              <a class="toc__link" href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  ) : (
    <aside class="article-toc-desktop">
      <nav class="toc" aria-label="Sommaire">
        <p class="toc__title">Sommaire</p>
        <ul class="toc__list">
          {items.map((h) => (
            <li class={`toc__item toc__item--h${h.depth}`}>
              <a class="toc__link" href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )
)}
