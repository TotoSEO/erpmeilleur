---
import Wordmark from './Wordmark.astro';
import { MEGA } from '../data/cocon';
/**
 * SiteHeader — barre sticky + méga-menu « Le guide ERP » (colonnes par branche).
 * Desktop : panneau au survol/focus. Mobile : menu déroulant groupé.
 */
interface Props { current?: string; }
const { current } = Astro.props;
const DIRECT = [
  { id: 'modules', label: 'Modules', href: '/modules-erp/' },
  { id: 'prix', label: 'Prix', href: '/prix-erp/' },
  { id: 'glossaire', label: 'Glossaire', href: '/glossaire-erp/' },
  { id: 'auteur', label: "L'auteur", href: '/auteur/' },
];
---
<header class="site-header">
  <div class="site-header__bar">
    <Wordmark href="/" size={30} />

    <nav class="site-nav" aria-label="Navigation principale">
      <div class="nav-mega">
        <button class="site-nav__link nav-mega__btn" aria-expanded="false" aria-haspopup="true" data-mega>
          Le guide ERP
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </button>
        <div class="mega" data-mega-panel>
          <div class="mega__grid">
            {MEGA.map((col) => (
              <div class="mega__col">
                <div class="mega__col-title">{col.label}</div>
                <ul>
                  {col.links.map((l) => (<li><a href={`/${l.slug}/`}>{l.label}</a></li>))}
                </ul>
              </div>
            ))}
          </div>
          <a class="mega__all" href="/plan-du-site/">Voir tout le plan du site →</a>
        </div>
      </div>
      {DIRECT.map((n) => (
        <a class="site-nav__link" href={n.href} aria-current={current === n.id ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>

    <div class="site-header__meta">
      <button class="burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" data-burger>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" data-mobile-nav hidden aria-label="Navigation mobile">
    {MEGA.map((col) => (
      <details class="mobile-nav__group">
        <summary>{col.label}</summary>
        {col.links.map((l) => (<a href={`/${l.slug}/`}>{l.label}</a>))}
      </details>
    ))}
    <a class="mobile-nav__direct" href="/glossaire-erp/">Glossaire</a>
    <a class="mobile-nav__direct" href="/auteur/">L'auteur</a>
    <a class="mobile-nav__direct" href="/plan-du-site/">Plan du site</a>
  </nav>
</header>

<style>
  .nav-mega { position: static; display: inline-flex; }
  .nav-mega__btn { display: inline-flex; align-items: center; gap: 5px; border: none; background: transparent; cursor: pointer; }
  .nav-mega__btn svg { transition: transform 0.18s ease; }
  .mega {
    position: absolute; left: 0; right: 0; top: 100%;
    background: #fff; border-top: 1px solid var(--hairline); border-bottom: 2px solid var(--ink);
    box-shadow: 0 24px 40px -24px rgba(11, 11, 18, 0.35);
    padding: 26px 20px 22px; z-index: 60;
    opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
  }
  .nav-mega:hover .mega, .nav-mega:focus-within .mega, .nav-mega__btn[aria-expanded="true"] + .mega {
    opacity: 1; visibility: visible; transform: translateY(0);
  }
  .nav-mega:hover .nav-mega__btn svg, .nav-mega:focus-within .nav-mega__btn svg { transform: rotate(180deg); }
  .mega__grid { max-width: var(--content-wide); margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 22px 30px; }
  .mega__col-title { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--blue-ink); margin-bottom: 10px; }
  .mega__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
  .mega__col a { font-family: var(--font-ui); font-size: 14px; color: var(--ink-80); text-decoration: none; }
  .mega__col a:hover { color: var(--blue-ink); text-decoration: underline; text-underline-offset: 2px; }
  .mega__all { display: inline-block; max-width: var(--content-wide); margin: 18px auto 0; font-family: var(--font-ui); font-weight: 700; font-size: 13px; color: var(--blue-ink); text-decoration: none; }
  .mega__all:hover { text-decoration: underline; }

  .mobile-nav__group { border-bottom: 1px solid var(--hairline); }
  .mobile-nav__group summary { cursor: pointer; padding: 12px 8px; font-family: var(--font-ui); font-weight: 700; color: var(--ink); text-transform: uppercase; letter-spacing: 0.03em; font-size: 13px; list-style: none; }
  .mobile-nav__group summary::-webkit-details-marker { display: none; }
  .mobile-nav__group summary::after { content: "+"; float: right; color: var(--ink-55); }
  .mobile-nav__group[open] summary::after { content: "–"; }
  .mobile-nav__group a { display: block; padding: 9px 8px 9px 20px; font-size: 14px; color: var(--ink-80); text-decoration: none; border: none; text-transform: none; letter-spacing: 0; font-weight: 500; }
  .mobile-nav__direct { display: block; padding: 12px 8px; font-family: var(--font-ui); font-weight: 700; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--hairline); text-transform: uppercase; letter-spacing: 0.03em; font-size: 13px; }

  @media (max-width: 860px) { .nav-mega { display: none; } }
</style>

<script>
  // Burger mobile
  const btn = document.querySelector('[data-burger]');
  const menu = document.querySelector('[data-mobile-nav]');
  btn?.addEventListener('click', () => {
    const open = menu?.hasAttribute('hidden');
    if (open) menu?.removeAttribute('hidden'); else menu?.setAttribute('hidden', '');
    btn.setAttribute('aria-expanded', String(!!open));
  });

  // Méga-menu : clic (tactile) pour ouvrir/fermer, en plus du survol
  const mega = document.querySelector('[data-mega]');
  mega?.addEventListener('click', (e) => {
    e.preventDefault();
    const open = mega.getAttribute('aria-expanded') === 'true';
    mega.setAttribute('aria-expanded', String(!open));
  });
  document.addEventListener('click', (e) => {
    if (mega && !mega.parentElement?.contains(e.target as Node)) mega.setAttribute('aria-expanded', 'false');
  });
</script>
